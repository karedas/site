---
import AiSection from '@/components/ai-section.astro';
import DotField from '@/components/dot-field.astro';
import SiteFooter from '@/components/site-footer.astro';
import SiteHeader from '@/components/site-header.astro';
import type { Locale } from '@/i18n';
import Layout from '@/layouts/layout.astro';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
---
<Layout locale={locale} page="ai">
  <DotField />
  <div class="shell">
    <SiteHeader locale={locale} page="ai" />
    <main id="main-content" style="min-height:62vh">
      <AiSection locale={locale} variant="page" />
    </main>
    <SiteFooter locale={locale} />
  </div>
</Layout>
