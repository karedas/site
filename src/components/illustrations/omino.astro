---
/**
 * The little figure holding the constellation. Hand-drawn ink line, back
 * view, arm raised: the strings continue in the live three.js field above.
 * Stroke inherits currentColor so the ink matches the page.
 */
---
<svg
  class="omino"
  viewBox="0 0 120 190"
  fill="none"
  stroke="currentColor"
  stroke-width="2.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  role="img"
  aria-hidden="true"
>
  {/* raised arm, up to the hand that holds the strings */}
  <path d="M63 74 C 60 60, 58 44, 59 26" />
  <path d="M55 24 C 57 20, 62 19, 64 23" />
  {/* head, tilted up a touch */}
  <circle cx="52" cy="52" r="13" />
  {/* a few hair strokes */}
  <path d="M42 44 C 44 40, 48 38, 52 39" />
  {/* back and shoulder line */}
  <path d="M52 65 C 50 84, 49 100, 50 118" />
  <path d="M52 68 C 58 70, 61 72, 63 74" />
  {/* relaxed arm */}
  <path d="M51 76 C 44 86, 41 96, 42 106" />
  {/* legs, a small step */}
  <path d="M50 118 C 49 136, 47 152, 44 168" />
  <path d="M50 118 C 54 136, 57 152, 60 166" />
  {/* feet */}
  <path d="M44 168 L 34 171" />
  <path d="M60 166 L 70 169" />
  {/* hint of ground, sparse hatching */}
  <g stroke-width="1.6" opacity="0.5">
    <path d="M28 176 L 40 174" />
    <path d="M48 178 L 62 177" />
    <path d="M70 175 L 80 174" />
  </g>
</svg>
