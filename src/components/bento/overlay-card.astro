---
import '@/components/bento/overlay-card.css';
import Glyph from '@/components/illustrations/glyph.astro';

type Props = {
  id: string;
  /** Tiny mono context label on the face ("come lavoro", "ai", ...). */
  label: string;
  /** May carry inline HTML from the copy. */
  title: string;
  glyph: 'seed' | 'saw' | 'signpost' | 'echo' | 'ticket' | 'violin' | 'kite' | 'path' | 'letter';
  closeLabel: string;
  tinted?: boolean;
};

const { id, label, title, glyph, closeLabel, tinted = false } = Astro.props;
const titleId = `${id}-title`;
---
<article class:list={['card', { tinted }]} data-rv>
  <button class="face" data-overlay-open={id} aria-haspopup="dialog">
    <span class="card-label label">{label}</span>
    <Glyph name={glyph} />
    <span class="card-title" set:html={title} />
    <span class="plus" aria-hidden="true">+</span>
  </button>

  <dialog id={id} class="overlay" aria-labelledby={titleId}>
    <div class="overlay-inner">
      <header class="overlay-head">
        <h3 class="overlay-title" id={titleId} set:html={title} />
        <button class="close" data-overlay-close aria-label={closeLabel}>&times;</button>
      </header>
      <div class="overlay-body">
        <slot />
      </div>
    </div>
  </dialog>
</article>
