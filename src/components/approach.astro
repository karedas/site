---
import '@/components/approach.css';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.approach;
---
<section class="approach section" id="approach">
  <SectionTitle num={head.num} title={head.title} />

  <div class="grid" data-reveal>
    {copy.approach.map((block) => (
      <div>
        <p class="block-title">
          <span class:list={['tick', block.tone && `tone-${block.tone}`]} aria-hidden="true">▹</span>
          {block.title}
        </p>
        <p class="block-body" set:html={block.body} />
      </div>
    ))}
  </div>
</section>
