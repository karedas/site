---
import SectionHeader from '@/components/section-header.astro';
import { getCopy, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.approach;
// Prose in first person, one short heading per block. Rendered via set:html
// so the inline <code>any</code> in the first block survives.
const blocks = copy.approach;
---
<section id="approach" data-sec="1" class="section">
  <SectionHeader num={head.num} title={head.title} eyebrow={head.eyebrow} />

  <div class="blocks">
    {blocks.map((block) => (
      <article class="block" data-rv>
        <h3 class="title" set:html={block.title} />
        <p class="body" set:html={block.body} />
      </article>
    ))}
  </div>
</section>

<style>
  .blocks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 1px;
    background: var(--line-12);
    border: 1px solid var(--line-12);
  }

  .block {
    padding: 30px 32px;
    background: var(--bg);
    transition: background 0.2s;
  }

  .block:hover {
    background: rgba(237, 229, 220, 0.03);
  }

  .title {
    margin: 0;
    font: 500 11px var(--font-mono);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .body {
    margin: 18px 0 0;
    font: 300 16px/1.75 var(--font-display);
    color: var(--fg-75);
    text-wrap: pretty;
  }

  .body :global(code) {
    font: 400 0.86em var(--font-mono);
    color: var(--accent);
    border: 1px solid var(--accent-line-soft);
    padding: 1px 6px;
  }
</style>
