---
import '@/components/focus.css';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.focus;
---
<section class="focus section" id="focus">
  <SectionTitle num={head.num} title={head.title} />

  <div class="focus-grid" data-reveal>
    {copy.focus.map((group) => (
      <div class="focus-group">
        <h3>{group.title}</h3>
        <ul>
          {group.items.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    ))}
  </div>
</section>
