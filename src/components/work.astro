---
import '@/components/work.css';
import Icon from '@/components/icon.astro';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.experience;

/* One line icon per chip label, so the marks mean something instead of
   repeating the same dot four times. */
const ICONS: Record<string, Parameters<typeof Icon>[0]['name']> = {
  Architettura: 'layers',
  Architecture: 'layers',
  Governance: 'shield',
  Standard: 'grid',
  Standards: 'grid',
  'Micro-frontends': 'layers',
  Microfrontend: 'layers',
  '16 projects': 'grid',
  '16 progetti': 'grid',
  '12+ teams': 'stack',
  '12+ team': 'stack',
  'Quality gates': 'shield',
  React: 'react',
  Vue: 'box',
  GraphQL: 'graph',
  ASP: 'box',
  jQuery: 'box',
  Webpack: 'box',
  Web: 'box',
  Backend: 'server',
  Design: 'pen',
  Infrastructure: 'server',
  Infrastruttura: 'server',
};

/* Tags whose icon carries the art-foundation colour: the same lilac as the
   school in the hero, on the job where the drawing was the job. */
const ROOT_TAGS = new Set(['Design']);
---
<section class="work section" id="experience">
  <SectionTitle num={head.num} title={head.title} />

  {copy.work.map((job) => (
    <article class="job" data-reveal>
      <div class="job-head">
        <h3 class="job-title">
          {job.title} <span class="at">@ {job.company}</span>
        </h3>
        {job.current && (
          <span class="now">
            <span class="pulse" aria-hidden="true"></span>
            {copy.nowBadge}
          </span>
        )}
        <span class:list={['years', { live: job.current }]}>{job.years}</span>
      </div>
      <p class="meta">{job.context} · {job.place}</p>

      <div class="duties">
        {job.paragraphs.map((duty) => (
          <div class="duty">
            <span class="mark" aria-hidden="true">▹</span>
            <p set:html={duty} />
          </div>
        ))}
      </div>

      <div class="chips">
        {job.tags.map((tag) => (
          <span class:list={['chip', { root: ROOT_TAGS.has(tag) }]}>
            <Icon name={ICONS[tag] ?? 'box'} size={17} />
            {tag}
          </span>
        ))}
      </div>
    </article>
  ))}
</section>
