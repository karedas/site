---
import { getCopy, hrefFor, LOCALES, type Locale, type PageKey } from '@/i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const copy = getCopy(locale);
---
<nav class="lang" aria-label={copy.langSwitchLabel}>
  {LOCALES.map((code, i) => (
    <>
      {i > 0 && <span class="sep" aria-hidden="true">/</span>}
      <a
        href={hrefFor(code, page)}
        hreflang={code}
        lang={code}
        class:list={['opt', { current: code === locale }]}
        aria-current={code === locale ? 'true' : undefined}
      >
        {getCopy(code).langName}
      </a>
    </>
  ))}
</nav>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .opt {
    color: var(--fg-52);
    transition: color 0.2s;
  }

  .opt:hover,
  .opt:focus-visible {
    color: var(--accent);
  }

  .opt.current {
    color: var(--fg);
    font-weight: 600;
  }

  .sep {
    color: var(--line-25);
  }
</style>
