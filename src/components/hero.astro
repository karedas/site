---
import '@/components/hero.css';
import Icon from '@/components/icon.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const { hero } = getCopy(locale);
const cvFile = locale === 'it' ? 'andrea-lisi-cv-it.pdf' : 'andrea-lisi-cv.pdf';
---
<section class="hero" id="top">
  <div class="text">
    <p class="greeting">{hero.greeting}</p>
    <h1 class="name">Andrea Lisi.</h1>
    <p class="tagline">{hero.tagline}</p>
    <p class="specialization">{hero.eyebrow}</p>
    <p class="intro">{hero.intro}</p>

    <div class="actions">
      <a class="cv" href={`/${cvFile}`} download={cvFile}>{hero.buttons.cv}</a>
      <a class="text-link" href="mailto:lisandr84@gmail.com">{hero.buttons.email}</a>
      <a
        class="social"
        href="https://github.com/karedas"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={hero.buttons.github}
      >
        <Icon name="github" />
      </a>
      <a
        class="social"
        href="https://www.linkedin.com/in/andrea-lisi84"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={hero.buttons.linkedin}
      >
        <Icon name="linkedin" />
      </a>
    </div>
    <div class="facts">
      {hero.stats.map((s) => (
        <div class="fact">
          <span class="fact-k">{s.label}</span>
          <span class:list={['fact-v', s.tone && `tone-${s.tone}`]}>{s.value}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="portrait">
    <picture>
      <source srcset="/andrea-lisi-424.webp 424w, /andrea-lisi.webp 848w" sizes="(max-width: 740px) 72px, 190px" type="image/webp" />
      <img
        src="/andrea-lisi.jpg"
        width="424"
        height="424"
        alt="Andrea Lisi"
        fetchpriority="high"
      />
    </picture>
  </div>
</section>
