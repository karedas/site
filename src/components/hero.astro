---
import '@/components/hero.css';
import Icon from '@/components/icon.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const { hero } = getCopy(locale);
const cvFile = locale === 'it' ? 'andrea-lisi-cv-it.pdf' : 'andrea-lisi-cv.pdf';

/* Hero content is above the fold, so it enters on load with a short stagger
   rather than waiting for a scroll observer. */
const step = (i: number): string => `animation-delay:${(0.05 * i).toFixed(2)}s`;
---
<section class="hero" id="top">
  <div class="text">
    <p class="greeting enter" style={step(0)}>{hero.greeting}</p>
    <h1 class="name enter" style={step(1)}>Andrea Lisi.</h1>
    <p class="tagline enter" style={step(2)}>{hero.tagline}</p>
    <p class="intro enter" style={step(3)}>{hero.intro}</p>
    <p class="role enter" style={step(4)}>{hero.eyebrow}</p>

    <div class="facts enter" style={step(5)}>
      {hero.stats.map((s) => (
        <div class="fact">
          <span class="fact-k">{s.label}</span>
          <span class:list={['fact-v', s.tone && `tone-${s.tone}`]}>{s.value}</span>
        </div>
      ))}
    </div>

    <div class="actions enter" style={step(6)}>
      <a class="cv" href={`/${cvFile}`} download={cvFile}>{hero.buttons.cv}</a>
      <a
        class="social"
        href="https://github.com/karedas"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={hero.buttons.github}
      >
        <Icon name="github" />
      </a>
      <a
        class="social"
        href="https://www.linkedin.com/in/andrea-lisi84"
        target="_blank"
        rel="noopener noreferrer"
        aria-label={hero.buttons.linkedin}
      >
        <Icon name="linkedin" />
      </a>
      <a class="social" href="mailto:lisandr84@gmail.com" aria-label={hero.buttons.email}>
        <Icon name="mail" />
      </a>
    </div>
  </div>

  <div class="portrait enter" style={step(3)}>
    <picture>
      <source srcset="/andrea-lisi-424.webp 424w, /andrea-lisi.webp 848w" type="image/webp" />
      <img
        src="/andrea-lisi.jpg"
        width="424"
        height="424"
        alt="Andrea Lisi"
        fetchpriority="high"
      />
    </picture>
  </div>
</section>
