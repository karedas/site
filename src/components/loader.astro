---
import '@/components/loader.css';
/**
 * The square draws itself, the initials fade in, the accent dot lands, and
 * the whole thing lifts away. Under a second and a half, once per load.
 * Removed entirely under prefers-reduced-motion, see motion.css.
 */
---
<div class="loader" aria-hidden="true">
  <div class="glyph">
    <svg viewBox="0 0 104 104" width="104" height="104">
      <rect x="2" y="2" width="100" height="100" fill="none" stroke="var(--acc)" stroke-width="2" />
    </svg>
    <span class="initials">AL</span>
    <span class="dot"></span>
  </div>
</div>
