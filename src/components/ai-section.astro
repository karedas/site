---
import '@/components/ai-section.css';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
  /** 'section' sits inside the home page, 'page' owns the <h1> at /ai. */
  variant?: 'section' | 'page';
};

const { locale, variant = 'section' } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.ai;
const { ai } = copy;
---
<section class="ai section" id="ai">
  {variant === 'section' ? (
    <SectionTitle num={head.num} title={ai.heading} />
  ) : (
    <h1 class="section-title" data-reveal>
      <span class="num">{head.num}.</span>{ai.heading}
      <span class="rule" aria-hidden="true"></span>
    </h1>
  )}

  <div class="plate" data-reveal>
    <p class="eyebrow">{head.eyebrow}</p>
    <div class="prose">
      {ai.paragraphs.map((para, i) => (
        <p class:list={{ lede: i === 0 }} set:html={para} />
      ))}
    </div>
  </div>
</section>
