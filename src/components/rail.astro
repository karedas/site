---
// Fixed left rail (desktop) + bottom bar (mobile) with scrollspy nav.
// The label ships next to the number: a number alone is unreadable for
// anyone skimming, and on mobile the title attribute never surfaces.
import { getCopy, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { nav } = getCopy(locale);
const navItems = nav.items.map((it) => ({ ...it, href: `#${it.target}` }));
---
<nav class="rail" aria-label={nav.ariaLabel}>
  <a class="logo" href="#top" aria-label={nav.logoLabel}>AL</a>
  <div class="spacer" aria-hidden="true"></div>
  <div class="links">
    {navItems.map((nv) => (
      <a href={nv.href} data-nav>
        <span class="num" aria-hidden="true">{nv.num}</span>
        <span class="label">{nv.label}</span>
      </a>
    ))}
  </div>
  <div class="spacer" aria-hidden="true"></div>
</nav>

<nav class="bottom-bar" aria-label={nav.ariaLabel}>
  <a class="logo" href="#top" aria-label={nav.logoLabel}>AL</a>
  <div class="links">
    {navItems.slice(1).map((nv) => (
      <a href={nv.href} data-nav>{nv.label}</a>
    ))}
  </div>
</nav>

<style>
  .rail {
    position: fixed;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--rail-w);
    border-right: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    padding: 24px 20px;
    gap: 22px;
    background: var(--bg);
    z-index: 50;
  }

  .rail .logo {
    font: 700 15px var(--font-display);
    letter-spacing: 0.05em;
    color: var(--accent);
  }

  .spacer {
    flex: 1;
    width: 1px;
    align-self: center;
    background: var(--line);
  }

  .rail .links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .rail .links a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-58);
    transition: color 0.2s;
  }

  .rail .links .num {
    color: var(--fg-52);
    font-variant-numeric: tabular-nums;
    transition: color 0.2s;
  }

  .links a:hover,
  .links a.active {
    color: var(--accent);
  }

  .rail .links a:hover .num,
  .rail .links a.active .num {
    color: var(--accent);
  }

  .bottom-bar {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    height: 56px;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    border-top: 1px solid var(--line);
    background: rgba(25, 20, 18, 0.95);
    backdrop-filter: blur(8px);
    z-index: 50;
  }

  .bottom-bar .logo {
    flex: none;
    font: 700 14px var(--font-display);
    color: var(--accent);
  }

  /* Labels can outgrow a narrow phone: let the row scroll rather than wrap
     or truncate. */
  .bottom-bar .links {
    display: flex;
    gap: 18px;
    overflow-x: auto;
    scrollbar-width: none;
    font: 500 10px var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .bottom-bar .links::-webkit-scrollbar {
    display: none;
  }

  @media (max-width: 899px) {
    .rail {
      display: none;
    }

    .bottom-bar {
      display: flex;
    }
  }
</style>

<script>
  // Scrollspy: highlight the nav entry of the section in view.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-nav]'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-sec]'));

  const setActive = (sec: string) => {
    for (const a of links) {
      a.classList.toggle('active', a.getAttribute('href') === `#${sec}`);
    }
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (e.isIntersecting) setActive(e.target.id);
      }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  for (const el of sections) spy.observe(el);
  setActive('top');
</script>
