---
/**
 * The AI prose and its keyword lines, shared by the card overlay on the
 * home page and by the /ai deep-link page so they can never drift apart.
 */
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const { ai } = getCopy(locale);
---
{ai.paragraphs.map((para) => (
  <p set:html={para} />
))}

<div class="keywords">
  {ai.keywords.map((line) => (
    <p class="keyword-line">
      {line.map((keyword, i) => (
        <>
          {i > 0 && <span class="sep" aria-hidden="true"> · </span>}
          {keyword}
        </>
      ))}
    </p>
  ))}
</div>

<style>
  .keywords {
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .keyword-line {
    margin: 0;
    font: 400 11px/1.9 var(--mono);
    letter-spacing: 0.02em;
    color: var(--ink-soft);
  }

  .keyword-line .sep {
    color: var(--accent-ink);
  }
</style>
