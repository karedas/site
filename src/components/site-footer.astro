---
import '@/components/site-footer.css';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const year = 2026;
---
<footer class="site-footer" data-reveal>
  <span class="mono">&copy; {year} Andrea Lisi</span>
  <span class="mono built">{copy.footer.built}</span>
</footer>
