---
import '@/components/projects.css';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.projects;
---
<section class="projects section" id="projects">
  <SectionTitle num={head.num} title={head.title} />

  <div class="project-grid" data-reveal>
    {copy.projects.map((project) => (
      <article class="project">
        <div class="project-content">
        <p class="project-kind">{project.kind}</p>
        <h3>{project.name}</h3>
        <p class="project-description">{project.description}</p>
        <p class="project-description">{project.detail}</p>
        <ul class="project-tags">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {project.href && <a class="text-link project-link" href={project.href} target="_blank" rel="noopener noreferrer">{project.linkLabel}</a>}
        </div>
        <figure class:list={['project-preview', { terminal: !!project.command }]}>
          {project.imageAlt && project.imageSrc && (
            <img src={project.imageSrc} alt={project.imageAlt} width="1000" height="563" loading="lazy" decoding="async" />
          )}
          {project.gallery && (
            <div class="project-gallery">
              {project.gallery.map((shot) => (
                <a href={shot.src} target="_blank" rel="noopener noreferrer" aria-label={shot.label}>
                  <img src={shot.src} alt={shot.alt} width={shot.width} height={shot.height} loading="lazy" decoding="async" />
                  <span>{shot.label}</span>
                </a>
              ))}
            </div>
          )}
          {project.command && (
            <div class="command-preview">
              <span class="terminal-label">PowerShell</span>
              <div class="command-line"><span aria-hidden="true">&gt;</span> <code>{project.command}</code></div>
            </div>
          )}
          <figcaption>{project.caption}</figcaption>
        </figure>
      </article>
    ))}
  </div>
</section>
