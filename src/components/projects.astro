---
import '@/components/projects.css';
import SectionTitle from '@/components/section-title.astro';
import { getCopy, type Locale } from '@/i18n';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const copy = getCopy(locale);
const head = copy.sections.projects;
---
<section class="projects section" id="projects">
  <SectionTitle num={head.num} title={head.title} />

  <div class="project-grid" data-reveal>
    {copy.projects.map((project) => (
      <article class="project">
        <p class="project-kind">{project.kind}</p>
        <h3>{project.name}</h3>
        <p class="project-description">{project.description}</p>
        <ul class="project-tags">
          {project.tags.map((tag) => <li>{tag}</li>)}
        </ul>
        {project.command && <code>{project.command}</code>}
      </article>
    ))}
  </div>
</section>
